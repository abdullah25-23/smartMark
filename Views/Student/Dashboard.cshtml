@model SmartMarkMVC.Models.StudentDashboardViewModel
@{
    ViewData["Title"] = "My Classes";
    ViewData["ActivePage"] = "Dashboard";
    Layout = "_Layout";
    ViewBag.SidebarRole = "student";
}

<div class="dash-wrapper">
    @await Html.PartialAsync("_Sidebar")

    <main class="main-content">
        <header class="topbar">
            <div>
                <h2 class="page-title">Welcome, @Model.StudentName 👋</h2>
                <p class="page-sub">@DateTime.Now.ToString("dddd, MMMM dd, yyyy") · Spring Semester</p>
            </div>
            <div class="topbar-right">
                <div class="search-box">
                    <svg viewBox="0 0 20 20" fill="none" width="16" height="16"><circle cx="8" cy="8" r="5" stroke="#9CA3AF" stroke-width="1.5" /><path d="M13 13l3 3" stroke="#9CA3AF" stroke-width="1.5" stroke-linecap="round" /></svg>
                    <input type="text" id="searchInput" placeholder="Search classes..." oninput="filterClasses()" />
                </div>
                <div class="notif-btn">
                    <svg viewBox="0 0 24 24" fill="none" width="20" height="20"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0" stroke="#6B7280" stroke-width="1.6" stroke-linecap="round" /></svg>
                    <span class="notif-dot"></span>
                </div>
            </div>
        </header>

        @if (Model.SubjectsBelowThreshold > 0)
        {
            <div class="warning-banner">
                ⚠ You have @Model.SubjectsBelowThreshold subject(s) with attendance below 75%.
                Please ensure regular attendance.
            </div>
        }

        <div class="stats-strip">
            <div class="stat-card">
                <span class="stat-num">@Model.TotalSubjects</span>
                <span class="stat-lbl">Enrolled Classes</span>
            </div>
            <div class="stat-card">
                <span class="stat-num" style="color:@(Model.SubjectsBelowThreshold > 0 ? "#E07C1A" : "#059669")">
                    @Model.SubjectsBelowThreshold
                </span>
                <span class="stat-lbl">Below 75%</span>
            </div>
            <div class="stat-card">
                <span class="stat-num" style="color:#059669">
                    @(Model.Classes.Count(c => c.AttendancePercent >= 75))
                </span>
                <span class="stat-lbl">Good Standing</span>
            </div>
            <div class="stat-card">
                <span class="stat-num">
                    @(Model.Classes.Any() ? Model.Classes.Average(c => c.AttendancePercent).ToString("0") + "%" : "0%")
                </span>
                <span class="stat-lbl">Avg Attendance</span>
            </div>
        </div>

        @* Live Classes Section *@
        @{
            var liveClasses = Model.Classes.Where(c => c.IsLive).ToList();
        }
        @if (liveClasses.Any())
        {
            <div class="section-header">
                <span class="section-title">
                    <span class="live-dot"></span> Live Now
                </span>
            </div>
            <div class="class-grid" style="margin-bottom:28px;">
                @foreach (var cls in liveClasses)
                {
                    <a href="@cls.MeetingLink" target="_blank" class="class-card live-card">
                        <div class="card-top" style="background:@cls.GradientCss">
                            <div class="card-deco-circle"></div>
                            <div class="card-header-row">
                                <span class="class-chip">@cls.Chip</span>
                                <span class="live-badge">🔴 LIVE</span>
                            </div>
                            <h3 class="class-name-text">@cls.Name</h3>
                            <p class="class-teacher">@cls.Teacher</p>
                        </div>
                        <div class="card-bottom" style="color:@cls.HexColor">
                            <span style="font-size:13px;font-weight:600;color:#059669">Click to Join Class</span>
                            <span class="card-cta">Join →</span>
                        </div>
                    </a>
                }
            </div>
        }

        <div class="section-header">
            <span class="section-title">All Enrolled Classes</span>
            <span class="section-count">@Model.TotalSubjects classes</span>
        </div>

        <div class="class-grid" id="classGrid">
            @foreach (var cls in Model.Classes)
            {
                string badgeClass = cls.AttendancePercent >= 75 ? "done-badge" : "pending-badge";
                string badgeText = cls.AttendancePercent >= 75 ? "Good" : "Low Attendance";
                string barColor = cls.AttendancePercent >= 75 ? "#059669" : cls.AttendancePercent >= 60 ? "#E07C1A" : "#E24B4A";

                <a href="@Url.Action("ClassDetail", "Student", new { id = cls.Id })"
                   class="class-card js-nav" data-name="@cls.Name.ToLower()">
                    <div class="card-top" style="background:@cls.GradientCss">
                        <div class="card-deco-circle"></div>
                        <div class="card-header-row">
                            <span class="class-chip">@cls.Chip</span>
                            <span class="due-badge @badgeClass">@badgeText</span>
                        </div>
                        <h3 class="class-name-text">@cls.Name</h3>
                        <p class="class-teacher">@cls.Teacher</p>
                    </div>
                    <div class="card-bottom" style="color:@cls.HexColor">
                        <div class="progress-wrap">
                            <div class="progress-track">
                                <div class="progress-fill" style="width:@(cls.AttendancePercent)%;background:@barColor"></div>
                            </div>
                            <span class="progress-pct">@cls.AttendancePercent%</span>
                        </div>
                        <span class="card-cta">View →</span>
                    </div>
                </a>
            }
        </div>
    </main>
</div>

<div class="transition-overlay" id="overlay"></div>

@section Styles {
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Poppins',sans-serif;
            background: #F3F4FA;
            min-height: 100vh;
        }

        .dash-wrapper {
            display: flex;
            min-height: 100vh;
        }

        .sidebar {
            width: 240px;
            flex-shrink: 0;
            background: #fff;
            border-right: 1px solid #EBEBF5;
            display: flex;
            flex-direction: column;
            padding: 24px 0;
            position: fixed;
            top: 0;
            left: 0;
            bottom: 0;
        }

        .sidebar-logo {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 0 20px 24px;
            border-bottom: 1px solid #F0EFF8;
        }

        .sb-logo-icon {
            width: 40px;
            height: 40px;
            background: #EDE8FF;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .sb-brand {
            font-family: 'Nunito',sans-serif;
            font-size: 20px;
            font-weight: 900;
            color: #3D2F8E;
        }

            .sb-brand span {
                color: #7C4DFF;
            }

        .sidebar-nav {
            flex: 1;
            padding: 16px 12px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .nav-link {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 10px 12px;
            border-radius: 12px;
            text-decoration: none;
            color: #6B7280;
            font-size: 14px;
            font-weight: 500;
            transition: background .15s,color .15s;
        }

            .nav-link:hover {
                background: #F5F3FF;
                color: #7C4DFF;
            }

            .nav-link.active {
                background: #EDE8FF;
                color: #7C4DFF;
                font-weight: 600;
            }

        .sidebar-user {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 16px 20px 0;
            border-top: 1px solid #F0EFF8;
            margin-top: auto;
        }

        .user-avatar {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: linear-gradient(135deg,#7C4DFF,#B47FFF);
            color: #fff;
            font-size: 12px;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .user-name {
            font-size: 13px;
            font-weight: 600;
            color: #1A1235;
        }

        .user-role {
            font-size: 11px;
            color: #9899B8;
        }

        .logout-btn {
            margin-left: auto;
            color: #9899B8;
            text-decoration: none;
            display: flex;
            transition: color .15s;
        }

            .logout-btn:hover {
                color: #E24B4A;
            }

        .main-content {
            margin-left: 240px;
            flex: 1;
            padding: 28px 32px;
            animation: fadeInMain .5s ease .1s both;
        }

        @@keyframes fadeInMain {
            0% {
                opacity: 0;
                transform: translateY(12px)
            }

            100% {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .topbar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
        }

        .page-title {
            font-size: 22px;
            font-weight: 700;
            color: #1A1235;
        }

        .page-sub {
            font-size: 12px;
            color: #9899B8;
            margin-top: 2px;
        }

        .topbar-right {
            display: flex;
            align-items: center;
            gap: 14px;
        }

        .search-box {
            display: flex;
            align-items: center;
            gap: 8px;
            background: #fff;
            border: 1px solid #EBEBF5;
            border-radius: 12px;
            padding: 9px 14px;
        }

            .search-box input {
                border: none;
                outline: none;
                font-family: 'Poppins',sans-serif;
                font-size: 13px;
                color: #374151;
                width: 180px;
                background: transparent;
            }

        .notif-btn {
            width: 40px;
            height: 40px;
            background: #fff;
            border: 1px solid #EBEBF5;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            position: relative;
        }

        .notif-dot {
            position: absolute;
            top: 9px;
            right: 9px;
            width: 7px;
            height: 7px;
            background: #E24B4A;
            border-radius: 50%;
            border: 1.5px solid #fff;
        }

        .warning-banner {
            background: #FEF3C7;
            border: 1px solid #FCD34D;
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 13px;
            color: #92400E;
            margin-bottom: 20px;
        }

        .stats-strip {
            display: grid;
            grid-template-columns: repeat(4,1fr);
            gap: 16px;
            margin-bottom: 28px;
        }

        .stat-card {
            background: #fff;
            border-radius: 16px;
            padding: 18px 20px;
            display: flex;
            flex-direction: column;
            gap: 4px;
            border: 1px solid #EBEBF5;
        }

        .stat-num {
            font-size: 26px;
            font-weight: 800;
            color: #1A1235;
            font-family: 'Nunito',sans-serif;
        }

        .stat-lbl {
            font-size: 11px;
            color: #9899B8;
            font-weight: 500;
        }

        .section-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 16px;
        }

        .section-title {
            font-size: 15px;
            font-weight: 700;
            color: #1A1235;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .section-count {
            font-size: 12px;
            color: #9899B8;
            background: #F3F4FA;
            padding: 4px 12px;
            border-radius: 20px;
        }

        @@keyframes pulse {
            0%, 100% {
                opacity: 1;
                transform: scale(1)
            }

            50% {
                opacity: .5;
                transform: scale(1.3)
            }
        }

        .live-dot {
            width: 10px;
            height: 10px;
            background: #E24B4A;
            border-radius: 50%;
            display: inline-block;
            animation: pulse 1.5s ease-in-out infinite;
        }

        .live-badge {
            background: #E24B4A;
            color: #fff;
            font-size: 10px;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 20px;
            animation: pulse 1.5s ease-in-out infinite;
        }

        .class-grid {
            display: grid;
            grid-template-columns: repeat(3,1fr);
            gap: 18px;
        }

        .class-card {
            border-radius: 20px;
            overflow: hidden;
            text-decoration: none;
            display: flex;
            flex-direction: column;
            transition: transform .2s,box-shadow .2s;
            box-shadow: 0 2px 12px rgba(60,47,142,.06);
        }

        .live-card {
            box-shadow: 0 0 0 2px #E24B4A,0 4px 20px rgba(226,75,74,.2);
        }

        .class-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 14px 36px rgba(60,47,142,.14);
        }

        .card-top {
            height: 130px;
            padding: 18px 18px 14px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
        }

        .card-deco-circle {
            position: absolute;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            background: rgba(255,255,255,.12);
            bottom: -30px;
            right: -20px;
        }

        .card-header-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: auto;
        }

        .class-chip {
            font-size: 10px;
            font-weight: 700;
            color: rgba(255,255,255,.9);
            background: rgba(255,255,255,.2);
            padding: 3px 9px;
            border-radius: 20px;
            letter-spacing: .5px;
        }

        .due-badge {
            font-size: 10px;
            font-weight: 600;
            padding: 3px 9px;
            border-radius: 20px;
        }

        .pending-badge {
            background: rgba(255,255,255,.9);
            color: #B45309;
        }

        .done-badge {
            background: rgba(255,255,255,.9);
            color: #059669;
        }

        .class-name-text {
            font-size: 16px;
            font-weight: 700;
            color: #fff;
            line-height: 1.2;
            margin-bottom: 4px;
        }

        .class-teacher {
            font-size: 11px;
            color: rgba(255,255,255,.8);
        }

        .card-bottom {
            background: #fff;
            padding: 14px 18px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
        }

        .progress-wrap {
            display: flex;
            align-items: center;
            gap: 8px;
            flex: 1;
        }

        .progress-track {
            flex: 1;
            height: 5px;
            background: #F0EFF8;
            border-radius: 10px;
            overflow: hidden;
        }

        .progress-fill {
            height: 100%;
            border-radius: 10px;
            transition: width .6s ease;
        }

        .progress-pct {
            font-size: 11px;
            font-weight: 700;
            color: #9899B8;
            min-width: 30px;
            text-align: right;
        }

        .card-cta {
            font-size: 12px;
            font-weight: 700;
            white-space: nowrap;
        }

        .transition-overlay {
            position: fixed;
            inset: 0;
            background: #7C4DFF;
            transform: scaleY(0);
            transform-origin: bottom;
            z-index: 1000;
            transition: transform .5s cubic-bezier(.76,0,.24,1);
        }

            .transition-overlay.active {
                transform: scaleY(1);
            }
    </style>
}

@section Scripts {
    <script>
        function filterClasses() {
            var val = document.getElementById('searchInput').value.toLowerCase();
            document.querySelectorAll('#classGrid .class-card').forEach(function(card) {
                card.style.display = card.dataset.name.includes(val) ? '' : 'none';
            });
        }
        document.querySelectorAll('.js-nav').forEach(function(el){
            el.addEventListener('click',function(e){
                e.preventDefault();
                var href=this.getAttribute('href');
                document.getElementById('overlay').classList.add('active');
                setTimeout(function(){window.location.href=href;},520);
            });
        });
    </script>
}