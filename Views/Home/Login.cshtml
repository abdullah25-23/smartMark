@model SmartMarkMVC.Models.LoginViewModel
@{
    ViewData["Title"] = "Login";
    Layout = "_Layout";
}

@* Role Selection Screen *@
@if (string.IsNullOrEmpty(Model.Role))
{
    <div class="login-page">
        <div class="login-top">
            <div class="top-bg-circle c1"></div>
            <div class="top-bg-circle c2"></div>
            <div class="login-logo">
                <div class="login-logo-icon">
                    <svg viewBox="0 0 60 60" fill="none" width="30" height="30">
                        <rect x="13" y="7" width="28" height="36" rx="4" fill="white" opacity="0.4" />
                        <rect x="18" y="4" width="28" height="36" rx="4" fill="white" />
                        <path d="M24 16h16M24 23h16M24 30h11" stroke="#6C3FD6" stroke-width="2.5" stroke-linecap="round" />
                        <circle cx="46" cy="44" r="10" fill="white" />
                        <path d="M42 44l3 3 6-6" stroke="#6C3FD6" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <span class="login-logo-name">smart<span class="logo-accent">Mark</span></span>
            </div>
            <h1 class="login-heading">Welcome back!</h1>
            <p class="login-sub">Choose your role to continue</p>
        </div>

        <div class="login-body">
            <p class="role-label">I am a...</p>

            <a href="@Url.Action("Login", "Home", new { role = "Teacher" })"
               class="login-option teacher-opt js-nav">
                <div class="opt-icon teacher-icon">
                    <svg viewBox="0 0 32 32" fill="none" width="28" height="28">
                        <rect x="3" y="4" width="26" height="18" rx="3" fill="#9B6FEF" opacity="0.2" />
                        <rect x="3" y="4" width="26" height="18" rx="3" stroke="#7C3FD6" stroke-width="1.8" />
                        <path d="M10 24h12M16 22v2" stroke="#7C3FD6" stroke-width="1.8" stroke-linecap="round" />
                        <path d="M9 13l4 4 10-8" stroke="#7C3FD6" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <div class="opt-text">
                    <h3>Teacher</h3>
                    <p>Manage classes &amp; attendance</p>
                </div>
                <div class="opt-arrow teacher-arrow">
                    <svg viewBox="0 0 16 16" fill="none" width="14" height="14">
                        <path d="M3 8h10M9 4l4 4-4 4" stroke="#7C3FD6" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </a>

            <a href="@Url.Action("Login", "Home", new { role = "Student" })"
               class="login-option student-opt js-nav">
                <div class="opt-icon student-icon">
                    <svg viewBox="0 0 32 32" fill="none" width="28" height="28">
                        <circle cx="16" cy="9" r="5" fill="#FAC775" opacity="0.4" stroke="#B45309" stroke-width="1.8" />
                        <path d="M6 28c0-5.523 4.477-10 10-10s10 4.477 10 10" stroke="#B45309" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                </div>
                <div class="opt-text">
                    <h3>Student</h3>
                    <p>View classes &amp; attendance</p>
                </div>
                <div class="opt-arrow student-arrow">
                    <svg viewBox="0 0 16 16" fill="none" width="14" height="14">
                        <path d="M3 8h10M9 4l4 4-4 4" stroke="#B45309" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
            </a>

            <div class="login-footer">
                Need help? <a href="#" class="signup-link" onclick="showHelp()">Contact support</a>
            </div>
        </div>
    </div>
}
else
{
    @* Login Form Screen *@
    bool isTeacher = Model.Role == "Teacher";
    <div class="login-page">
        <div class="login-top" style="background:@(isTeacher ? "linear-gradient(150deg,#5B32C8 0%,#7C4DFF 60%,#9B6FEF 100%)" : "linear-gradient(150deg,#B45309 0%,#D97706 60%,#F59E0B 100%)")">
            <div class="top-bg-circle c1"></div>
            <div class="top-bg-circle c2"></div>
            <a href="@Url.Action("Login", "Home", new { role = "" })" class="back-link">← Back</a>
            <div class="login-logo">
                <div class="login-logo-icon">
                    <svg viewBox="0 0 60 60" fill="none" width="30" height="30">
                        <rect x="13" y="7" width="28" height="36" rx="4" fill="white" opacity="0.4" />
                        <rect x="18" y="4" width="28" height="36" rx="4" fill="white" />
                        <path d="M24 16h16M24 23h16M24 30h11" stroke="@(isTeacher ? "#6C3FD6" : "#B45309")" stroke-width="2.5" stroke-linecap="round" />
                        <circle cx="46" cy="44" r="10" fill="white" />
                        <path d="M42 44l3 3 6-6" stroke="@(isTeacher ? "#6C3FD6" : "#B45309")" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
                    </svg>
                </div>
                <span class="login-logo-name">smart<span class="logo-accent">Mark</span></span>
            </div>
            <h1 class="login-heading">@(isTeacher ? "Teacher Login" : "Student Login")</h1>
            <p class="login-sub">@(isTeacher ? "Access your classes and attendance" : "Sign in with your university email")</p>
        </div>

        <div class="login-body">

            @* Error Message *@
            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="error-banner">
                    <svg viewBox="0 0 20 20" fill="none" width="16" height="16">
                        <circle cx="10" cy="10" r="9" stroke="#E24B4A" stroke-width="1.5" />
                        <path d="M10 6v4M10 13v1" stroke="#E24B4A" stroke-width="1.8" stroke-linecap="round" />
                    </svg>
                    @Model.ErrorMessage
                </div>
            }

            <form method="post" action="@Url.Action("Login","Home")">
                <input type="hidden" name="Role" value="@Model.Role" />

                <div class="input-group">
                    <label class="input-label">
                        @(isTeacher ? "Email Address" : "University Email (.edu.pk)")
                    </label>
                    <div class="input-wrap">
                        <svg class="input-icon" viewBox="0 0 20 20" fill="none" width="16" height="16">
                            <rect x="2" y="4" width="16" height="12" rx="2" stroke="#9899B8" stroke-width="1.4" />
                            <path d="M2 7l8 5 8-5" stroke="#9899B8" stroke-width="1.4" />
                        </svg>
                        <input type="email" name="Email"
                               placeholder="@(isTeacher ? "teacher@example.com" : "yourname@university.edu.pk")"
                               value="@Model.Email"
                               class="text-input" required />
                    </div>
                </div>

                <div class="input-group">
                    <label class="input-label">Password</label>
                    <div class="input-wrap">
                        <svg class="input-icon" viewBox="0 0 20 20" fill="none" width="16" height="16">
                            <rect x="4" y="8" width="12" height="10" rx="2" stroke="#9899B8" stroke-width="1.4" />
                            <path d="M7 8V6a3 3 0 016 0v2" stroke="#9899B8" stroke-width="1.4" stroke-linecap="round" />
                        </svg>
                        <input type="password" name="Password" id="passwordInput"
                               placeholder="Enter your password"
                               class="text-input" required />
                        <button type="button" class="eye-btn" onclick="togglePassword()">
                            <svg id="eyeIcon" viewBox="0 0 20 20" fill="none" width="16" height="16">
                                <path d="M2 10s3-6 8-6 8 6 8 6-3 6-8 6-8-6-8-6z" stroke="#9899B8" stroke-width="1.4" />
                                <circle cx="10" cy="10" r="2.5" stroke="#9899B8" stroke-width="1.4" />
                            </svg>
                        </button>
                    </div>
                </div>

                @if (!isTeacher)
                {
                    <p class="edu-hint">⚠ Only .edu.pk emails are allowed for students</p>
                }

                <button type="submit" class="submit-btn @(isTeacher ? "teacher-btn" : "student-btn")">
                    Sign In as @Model.Role
                </button>

                <div class="login-footer">
                    Forgot your password?
                    <a href="#" class="signup-link" onclick="showHelp()">Contact support</a>
                </div>
            </form>
        </div>
    </div>
}

<div class="transition-overlay" id="overlay"></div>

@section Styles {
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Poppins',sans-serif;
            min-height: 100vh;
            background: #F8F5FF;
        }

        .login-page {
            min-height: 100vh;
            max-width: 480px;
            margin: 0 auto;
            display: flex;
            flex-direction: column;
            animation: pageReveal .5s ease both;
        }

        @@keyframes pageReveal {
            0% {
                opacity: 0;
                transform: translateY(18px)
            }

            100% {
                opacity: 1;
                transform: translateY(0)
            }
        }

        .login-top {
            background: linear-gradient(150deg,#5B32C8 0%,#7C4DFF 60%,#9B6FEF 100%);
            padding: 56px 32px 48px;
            position: relative;
            overflow: hidden;
        }

        .top-bg-circle {
            position: absolute;
            border-radius: 50%;
        }

        .c1 {
            width: 220px;
            height: 220px;
            background: rgba(255,255,255,.08);
            bottom: -80px;
            right: -60px;
        }

        .c2 {
            width: 120px;
            height: 120px;
            background: rgba(255,255,255,.06);
            top: -30px;
            left: -30px;
        }

        .back-link {
            color: rgba(255,255,255,.8);
            text-decoration: none;
            font-size: 13px;
            display: inline-block;
            margin-bottom: 16px;
            transition: color .15s;
        }

            .back-link:hover {
                color: #fff;
            }

        .login-logo {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 28px;
        }

        .login-logo-icon {
            width: 46px;
            height: 46px;
            background: rgba(255,255,255,.18);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-logo-name {
            font-family: 'Nunito',sans-serif;
            font-size: 24px;
            font-weight: 900;
            color: #fff;
        }

        .logo-accent {
            color: #FAC775;
        }

        .login-heading {
            font-size: 28px;
            font-weight: 700;
            color: #fff;
            margin-bottom: 8px;
        }

        .login-sub {
            font-size: 14px;
            color: rgba(255,255,255,.72);
        }

        .login-body {
            flex: 1;
            padding: 32px 24px;
            display: flex;
            flex-direction: column;
            gap: 16px;
        }

        .role-label {
            font-size: 12px;
            font-weight: 600;
            color: #8878B0;
            text-transform: uppercase;
            letter-spacing: 1.2px;
            margin-bottom: 4px;
        }

        .login-option {
            background: #fff;
            border-radius: 20px;
            padding: 22px 20px;
            display: flex;
            align-items: center;
            gap: 18px;
            text-decoration: none;
            border: 2px solid transparent;
            transition: transform .18s,box-shadow .18s,border-color .18s;
            box-shadow: 0 4px 20px rgba(108,63,214,.08);
            animation: cardIn .5s cubic-bezier(.34,1.3,.64,1) both;
        }

        .teacher-opt {
            animation-delay: .1s;
        }

        .student-opt {
            animation-delay: .22s;
        }

        @@keyframes cardIn {
            0% {
                opacity: 0;
                transform: translateX(-20px)
            }

            100% {
                opacity: 1;
                transform: translateX(0)
            }
        }

        .login-option:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 32px rgba(108,63,214,.15);
        }

        .teacher-opt:hover {
            border-color: #C4ADFF;
        }

        .student-opt:hover {
            border-color: #FFD18A;
        }

        .opt-icon {
            width: 56px;
            height: 56px;
            border-radius: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .teacher-icon {
            background: #EDE8FF;
        }

        .student-icon {
            background: #FFF4DC;
        }

        .opt-text h3 {
            font-size: 16px;
            font-weight: 700;
            color: #1A1235;
            margin-bottom: 4px;
        }

        .opt-text p {
            font-size: 12px;
            color: #8878B0;
        }

        .opt-arrow {
            margin-left: auto;
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: transform .2s;
        }

        .teacher-arrow {
            background: #EDE8FF;
        }

        .student-arrow {
            background: #FFF4DC;
        }

        .login-option:hover .opt-arrow {
            transform: translateX(3px);
        }

        /* Form styles */
        .error-banner {
            background: #FEE2E2;
            border: 1px solid #FCA5A5;
            border-radius: 12px;
            padding: 12px 16px;
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            color: #991B1B;
        }

        .input-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .input-label {
            font-size: 13px;
            font-weight: 600;
            color: #374151;
        }

        .input-wrap {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            pointer-events: none;
        }

        .text-input {
            width: 100%;
            padding: 13px 44px;
            border: 2px solid #EBEBF5;
            border-radius: 14px;
            font-family: 'Poppins',sans-serif;
            font-size: 14px;
            color: #1A1235;
            background: #fff;
            outline: none;
            transition: border-color .2s;
        }

            .text-input:focus {
                border-color: #7C4DFF;
            }

        .eye-btn {
            position: absolute;
            right: 14px;
            background: none;
            border: none;
            cursor: pointer;
            padding: 4px;
            display: flex;
            align-items: center;
        }

        .edu-hint {
            font-size: 12px;
            color: #B45309;
            background: #FEF3C7;
            padding: 8px 12px;
            border-radius: 10px;
        }

        .submit-btn {
            width: 100%;
            padding: 15px;
            border: none;
            border-radius: 14px;
            font-family: 'Poppins',sans-serif;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: opacity .2s,transform .1s;
            margin-top: 4px;
        }

            .submit-btn:hover {
                opacity: .9;
            }

            .submit-btn:active {
                transform: scale(.98);
            }

        .teacher-btn {
            background: linear-gradient(135deg,#6C3FD6,#7C4DFF);
            color: #fff;
        }

        .student-btn {
            background: linear-gradient(135deg,#B45309,#D97706);
            color: #fff;
        }

        .login-footer {
            text-align: center;
            font-size: 13px;
            color: #A09CC0;
        }

        .signup-link {
            color: #6C3FD6;
            font-weight: 600;
            text-decoration: none;
        }

            .signup-link:hover {
                text-decoration: underline;
            }

        .transition-overlay {
            position: fixed;
            inset: 0;
            background: #7C4DFF;
            transform: scaleY(0);
            transform-origin: bottom;
            z-index: 1000;
            transition: transform .5s cubic-bezier(.76,0,.24,1);
        }

            .transition-overlay.active {
                transform: scaleY(1);
            }
    </style>
}

@section Scripts {
    <script>
        function togglePassword() {
            var input = document.getElementById('passwordInput');
            input.type = input.type === 'password' ? 'text' : 'password';
        }
        function showHelp() {
            alert('For account issues, please contact your system administrator.');
        }
        document.querySelectorAll('.js-nav').forEach(function(el) {
            el.addEventListener('click', function(e) {
                e.preventDefault();
                var href = this.getAttribute('href');
                document.getElementById('overlay').classList.add('active');
                setTimeout(function() { window.location.href = href; }, 520);
            });
        });
    </script>
}